# 复制为 .env 后填入自己的密钥（.env 已在 .gitignore 中，不会被提交）

# LLM：DeepSeek 官方接口（OpenAI 兼容）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_PROVIDER=deepseek

# 其它 OpenAI 兼容网关（如 SiliconFlow）：
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=MiniMaxAI/MiniMax-M2.5
# LLM_PROVIDER=openai

# 可选：embedding 后端（auto 时优先使用本地 GGUF 模型）
# SEMANTIC_CS_EMBEDDING_BACKEND=auto
# SEMANTIC_CS_LOCAL_EMBEDDING_MODEL=D:\path\to\bge-m3-Q8_0.gguf
